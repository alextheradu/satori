# Postgres 17 or 18
DATABASE_URL=postgres://satori:satori@localhost:5433/satori

# Public URL of the app. In dev this is the Vite server, which also runs the API.
APP_URL=http://localhost:5173

# Hack Club Auth app (create one at https://auth.hackclub.com/developer_apps)
# Redirect URI to register: ${APP_URL}/auth/callback
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
# HCA_ISSUER=https://auth.hackclub.com
# HCA_SCOPES=openid profile email slack_id
# HCA_USE_PKCE=false

# Desmos API key for the in-test calculator (https://www.desmos.com/my-api).
# Public by design: Vite inlines it into the frontend at build time.
VITE_DESMOS_API_KEY=

# Production server port (dev uses Vite's 5173)
PORT=3000
# SESSION_DAYS=30
